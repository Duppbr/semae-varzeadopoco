# Banco de dados PostgreSQL (Supabase ou outro Postgres)
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres?sslmode=require"

# Segredo para criptografia de sessão (mínimo 32 caracteres, deve ser aleatório)
# Gere com: openssl rand -base64 32
SECRET_COOKIE_PASSWORD="troque-por-um-segredo-aleatorio-de-pelo-menos-32-chars"

# Opcional: origens extras para app mobile/Capacitor em producao, separadas por virgula
ALLOWED_MOBILE_ORIGINS="https://semae-varzeadopoco.vercel.app"
